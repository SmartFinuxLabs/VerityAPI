NODE_ENV=development
HOST=0.0.0.0
PORT=8080
API_BASE_PATH=/api/v1

# Supabase is server-side only. Do not expose these values through VerityUI.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Required for backend-only writes, migrations, and trusted RPC execution.
# Keep this value out of frontend bundles and committed files.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
